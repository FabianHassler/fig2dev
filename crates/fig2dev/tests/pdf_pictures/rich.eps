%!PS-Adobe-3.0 EPSF-3.0
%%BoundingBox: 0 0 200 150
gsave 10 10 180 130 rectclip
0.9 0.9 1 setrgbcolor 0 0 200 150 rectfill
/Times-Roman findfont 24 scalefont setfont 0 0 0 setrgbcolor 20 100 moveto (Hello PDF) show
/Courier-Bold findfont 12 scalefont setfont 20 80 moveto (Courier bold) show
2 setlinewidth [6 3] 0 setdash 0 0.5 0 setrgbcolor 20 60 moveto 100 20 180 100 190 40 curveto stroke
[] 0 setdash 1 0 1 setrgbcolor 3 setlinewidth 1 setlinejoin 1 setlinecap 30 30 moveto 60 50 lineto 90 25 lineto stroke
gsave 130 20 translate 40 40 8 [1 0 0 1 0 0] {<ff0000 00ff00 0000ff ffff00>} false 3 colorimage grestore
grestore
showpage
